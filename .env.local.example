# Copia este archivo a .env.local y completa con tus credenciales reales de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# WhatsApp del negocio en formato internacional sin + ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER=593998001894

# Sendifico (cotización de envío en el carrito) — crea tu key en https://app.sendifico.com/integrations
SENDIFICO_API_KEY=YOUR-SENDIFICO-API-KEY
SENDIFICO_API_VERSION=2026-01-01
SENDIFICO_COUNTRY=EC
# territoryBaseId de origen (bodega/local del negocio) — obtenlo de GET /territory
SENDIFICO_SENDER_TERRITORY_BASE_ID=EC|:|AZUAY|:|CUENCA|:|CUENCA
# Paquete promedio usado para estimar el envío (no hay peso/medidas por producto todavía)
SENDIFICO_DEFAULT_PARCEL_WEIGHT=3
SENDIFICO_DEFAULT_PARCEL_LENGTH=40
SENDIFICO_DEFAULT_PARCEL_WIDTH=30
SENDIFICO_DEFAULT_PARCEL_HEIGHT=20
