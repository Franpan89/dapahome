# Copia este archivo a .env.local y completa con tus credenciales reales de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# WhatsApp del negocio en formato internacional sin + ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER=593998001894

# PayPhone (pago con tarjeta en el carrito) — panel de desarrollador en https://appdeveloper.payphone.app
# El token se embebe en la Cajita de Pagos del lado del cliente (así lo exige PayPhone),
# por eso va con prefijo NEXT_PUBLIC_. El servidor usa el mismo valor para confirmar el pago.
# Recuerda registrar https://tu-dominio.com/pago/retorno como Response URL de tu app WEB en PayPhone.
NEXT_PUBLIC_PAYPHONE_TOKEN=YOUR-PAYPHONE-TOKEN
NEXT_PUBLIC_PAYPHONE_STORE_ID=YOUR-PAYPHONE-STORE-ID
